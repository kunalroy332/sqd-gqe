# Credentials for the real IBM Quantum hardware sampler (sqd_gqe.gqe.ibm_hardware_sampler).
# Copy this file to .env.local (or .env), fill in real values, then load it into your shell
# before running training/inference with --sampler-kind ibm_hardware:
#
#   set -a; source .env.local; set +a
#
# .env.local (and .env*) are gitignored -- never commit real credentials.

# API key/token for the IBM Quantum Platform account (channel="ibm_quantum_platform" by
# default -- see sqd_gqe/factory.py's IbmHardwareSampler construction).
IBM_API_KEY=

# Cloud Resource Name (CRN) of the IBM Quantum instance/service to bill jobs against.
IBM_CRN=
